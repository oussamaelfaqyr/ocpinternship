# ==============================================================================
# OCP Youssoufia 60 kV SCADA Digital Twin — .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# MLflow Tracking & Databases
mlruns/
*.db
*.sqlite
*.sqlite3

# DVC Internal
.dvc/cache
.dvc/tmp

# PyTorch / Deep Learning checkpoints (exclude huge temp dumps, keep production models)
*.pt.tmp
*.pth.tmp
*.ckpt

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDEs & Text Editors
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs & Temporary Scratch Files
*.log
scratch/
tmp/
temp/
*.tmp
